FROM ubuntu:24.04 AS wayland
RUN apt-get update && apt-get install -y --no-install-recommends gstreamer1.0-plugins-bad \
    && rm -rf /var/lib/apt/lists/*

FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates gstreamer1.0-tools gstreamer1.0-plugins-base gstreamer1.0-plugins-good \
    && rm -rf /var/lib/apt/lists/*
COPY --from=wayland /usr/lib/aarch64-linux-gnu/gstreamer-1.0/libgstwaylandsink.so /usr/lib/aarch64-linux-gnu/gstreamer-1.0/
COPY --from=wayland /usr/lib/aarch64-linux-gnu/gstreamer-1.0/libgsthls.so /usr/lib/aarch64-linux-gnu/gstreamer-1.0/
COPY --from=wayland /usr/lib/aarch64-linux-gnu/libgstadaptivedemux-1.0.so.0* /usr/lib/aarch64-linux-gnu/
COPY --from=wayland /usr/lib/aarch64-linux-gnu/libgsturidownloader-1.0.so.0* /usr/lib/aarch64-linux-gnu/
COPY --from=wayland /usr/lib/aarch64-linux-gnu/libgstwayland-1.0.so.0* /usr/lib/aarch64-linux-gnu/
COPY --from=wayland /usr/lib/aarch64-linux-gnu/libwayland-client.so.0* /usr/lib/aarch64-linux-gnu/
COPY bin/libgstrknnface.so /usr/lib/aarch64-linux-gnu/gstreamer-1.0/
COPY rockchip/libgstvideo-1.0.so.0.2402.0 /usr/lib/aarch64-linux-gnu/
COPY rockchip/librga.so.2 /usr/lib/aarch64-linux-gnu/
RUN ln -sf libgstvideo-1.0.so.0.2402.0 /usr/lib/aarch64-linux-gnu/libgstvideo-1.0.so.0
COPY include/gst_rknn_face_meta.h /usr/local/include/
COPY lib/librknnrt.so /opt/face-rknn/lib/librknnrt.so
COPY models/ /app/models/
ENV LD_LIBRARY_PATH=/opt/face-rknn/lib
ENV GST_VIDEO_CONVERT_USE_RGA=1
ENV GST_VIDEO_CONVERT_RGA_DMA_HEAP=/dev/dma_heap/cma
ENTRYPOINT ["gst-launch-1.0"]
