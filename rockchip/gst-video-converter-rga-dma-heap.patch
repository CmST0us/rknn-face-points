+static void
+release_rga_dma_buffer (RgaDmaBuffer * buffer)
+{
+  if (!buffer->ptr)
+    return;
+
+  munmap (buffer->ptr, buffer->size);
+  close (buffer->fd);
+  memset (buffer, 0, sizeof (*buffer));
+}
+
 static gboolean
+ensure_rga_dma_buffer (RgaDmaBuffer * buffer, gsize size)
+{
+  struct dma_heap_allocation_data data = { 0 };
+  const gchar *heap_path = g_getenv ("GST_VIDEO_CONVERT_RGA_DMA_HEAP");
+  gint heap_fd;
+
+  if (buffer->ptr && buffer->size >= size)
+    return TRUE;
+
+  release_rga_dma_buffer (buffer);
+  if (!heap_path)
+    heap_path = "/dev/dma_heap/cma";
+  heap_fd = open (heap_path, O_RDONLY | O_CLOEXEC);
+  if (heap_fd < 0)
+    return FALSE;
+
+  data.len = (size + 4095) & ~((gsize) 4095);
+  data.fd_flags = O_RDWR | O_CLOEXEC;
+  if (ioctl (heap_fd, DMA_HEAP_IOCTL_ALLOC, &data) < 0) {
+    close (heap_fd);
+    return FALSE;
+  }
+  close (heap_fd);
+
+  buffer->ptr = mmap (NULL, data.len, PROT_READ | PROT_WRITE, MAP_SHARED,
+      data.fd, 0);
+  if (buffer->ptr == MAP_FAILED) {
+    buffer->ptr = NULL;
+    close (data.fd);
+    return FALSE;
+  }
+  buffer->fd = data.fd;
+  buffer->size = data.len;
+  return TRUE;
+}
+
+static gboolean
+sync_rga_dma_buffer (gint fd, guint64 flags)
+{
+  struct dma_buf_sync sync = { .flags = flags };
+  return ioctl (fd, DMA_BUF_IOCTL_SYNC, &sync) == 0;
+}
